{
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog/best-sermon-apps", "destination": "/blog/best-sermon-notes-apps", "permanent": true },
    { "source": "/blog/best-sermon-notes-app", "destination": "/blog/best-sermon-notes-apps", "permanent": true },
    { "source": "/blog/best-sermon-spg-app", "destination": "/blog/best-sermon-notes-apps", "permanent": true },
    { "source": "/blog/best-sermon-transcription-app", "destination": "/blog/best-ai-sermon-transcription-app", "permanent": true },
    { "source": "/blog/is-is-legal-to-record-sermons", "destination": "/blog/is-it-legal-to-record-sermons", "permanent": true },
    { "source": "/blog/soap-method-bible-study", "destination": "/blog/soap-bible-study-method", "permanent": true },
    { "source": "/blog/soap-study-method", "destination": "/blog/soap-bible-study-method", "permanent": true },
    { "source": "/blog/soap-affb-study-method", "destination": "/blog/soap-bible-study-method", "permanent": true },
    { "source": "/blog/soap-bildung", "destination": "/blog/soap-bible-study-method", "permanent": true },
    { "source": "/blog/soap-sermonkeeper.app", "destination": "/blog/soap-bible-study-method", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/scss/image/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/scss/font/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
