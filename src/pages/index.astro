---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBlogTeaser from '../components/HomeBlogTeaser.astro';
import FinalBanner from '../components/FinalBanner.astro';
import { pageAppStoreUrl } from '../utils/site';
import { faqSchema } from '../utils/seo';
import AppleIcon from '../components/AppleIcon.astro';

const schemas = [
 {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sermon Keeper",
  "alternateName": "Sermon Keeper - Smart Notes",
  "description": "AI-powered sermon notes app for iOS. Record sermons, take timestamped notes, get automatic transcription with summary and key points. Built specifically for churchgoers who want to remember every sermon.",
  "url": "https://sermonkeeper.app",
  "operatingSystem": "iOS",
  "applicationCategory": "ReligionApplication",
  "offers": [
   {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free 3-day trial"
   },
   {
    "@type": "Offer",
    "price": "6.99",
    "priceCurrency": "USD",
    "description": "Monthly subscription for unlimited recordings"
   },
   {
    "@type": "Offer",
    "price": "64.99",
    "priceCurrency": "USD",
    "description": "Annual subscription for unlimited recordings, with a 3-day free trial"
   }
  ],
  "featureList": [
   "One-tap sermon recording in high quality audio",
   "Timestamped notes synced to audio playback",
   "Bible verse autocomplete in 7 translations, offline",
   "AI-powered speech-to-text transcription",
   "Automatic sermon summary with key points",
   "iCloud sync across devices",
   "English and Spanish support",
   "No account required"
  ],
  "screenshot": "https://sermonkeeper.app/scss/image/og-image.jpg",
  "installUrl": "https://apps.apple.com/app/apple-store/id6758739935?pt=128512327&ct=landing_page&mt=8",
  "author": {
   "@type": "Organization",
   "name": "Sermon Keeper",
   "url": "https://sermonkeeper.app",
   "email": "hello@sermonkeeper.app",
   "sameAs": [
    "https://apps.apple.com/app/apple-store/id6758739935",
    "https://www.wikidata.org/wiki/Q140811548"
   ]
  },
  "inLanguage": [
   "en",
   "es"
  ]
 },
 {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sermon Keeper",
  "url": "https://sermonkeeper.app",
  "description": "AI-powered sermon notes app for iOS. Record, transcribe, and never miss an insight from your church sermons.",
  "publisher": {
   "@type": "Organization",
   "name": "Sermon Keeper",
   "url": "https://sermonkeeper.app",
   "logo": {
    "@type": "ImageObject",
    "url": "https://sermonkeeper.app/apple-touch-icon.png"
   }
  }
 }
];
// Homepage FAQ, rendered with the same accordion the articles use.
const HOME_FAQ = [
 {
  "question": "What is Sermon Keeper?",
  "answer": "A sermon notes app for iPhone. It records the sermon while you type short church notes, then gives you the full transcript, a summary with the pastor's outline and every Bible verse named."
 },
 {
  "question": "Is Sermon Keeper free?",
  "answer": "Yes, you can try it free: the yearly plan starts with a 3-day free trial, and no account is needed. Plans are $6.99/month or $64.99/year."
 },
 {
  "question": "What languages are supported?",
  "answer": "English and Spanish: both the app and AI transcription."
 },
 {
  "question": "What Bible version is used?",
  "answer": "Seven translations, all built in and working offline: KJV, NASB 1995, ESV, NKJV, NIV 1984, WEB and Reina-Valera 1909."
 },
 {
  "question": "Can I share my notes?",
  "answer": "Yes. Export a sermon as a PDF with the summary, your notes, photos and verses, or share it as text. The full transcript can be shared as a text file."
 },
 {
  "question": "Best app to record sermons on iPhone?",
  "answer": "Sermon Keeper is built specifically for church, with timestamped notes, Bible verses, and AI summaries."
 },
 {
  "question": "Can I upload a recording I already have?",
  "answer": "Yes. Upload an MP3, M4A, WAV, AIFF or AAC file up to 3 hours long, and you get the same transcript and summary."
 },
 {
  "question": "Does it keep recording with the screen locked?",
  "answer": "Yes. Recording goes on with the screen locked for up to 3 hours, and you can pause it from the Lock Screen."
 },
 {
  "question": "Does it work offline?",
  "answer": "Recording and all seven Bible translations work offline. The transcript and summary need internet and are usually ready in 2–3 minutes."
 },
 {
  "question": "Is it a Bible notes app too?",
  "answer": "Yes. Type a reference and the full verse fills in, and Scan Scripture turns a photo of a Bible page into a study card."
 },
 {
  "question": "Can I find an old sermon?",
  "answer": "Yes. Search looks through titles, notes, transcripts and summaries of every sermon you kept."
 },
 {
  "question": "Will I lose my recordings?",
  "answer": "No. Your sermons, recordings and photos are saved to your own iCloud and stay in sync across your devices."
 },
 {
  "question": "Do I need an account?",
  "answer": "No sign-up required. Just download and start recording."
 },
 {
  "question": "Is my data secure?",
  "answer": "Your notes sync through your own personal iCloud, not our servers. The audio you record is sent to our server only to create the transcript, then deleted. We don't sell your data."
 }
];
// FAQPage schema is generated from the same HOME_FAQ the visible accordion renders,
// so the two can never drift (Google drops FAQ rich results when they do).
schemas.splice(1, 0, faqSchema(HOME_FAQ));


const IMG = '/scss/image/home';
const BUBBLES_L = ['Turn with me to Obadiah.', "Let's read Habakkuk 2:3.", 'Hold your place in Zephaniah.'];
const BUBBLES_R = ['As Paul writes in Romans 8…', 'Go back to Nahum, chapter one.', 'Keep a finger in Malachi.'];
---

<BaseLayout
	title="Sermon Keeper: AI Sermon Notes & Recording App for iPhone"
	description="Record sermons, take timestamped notes, and get automatic AI transcription with a summary. The sermon notes app for iPhone. Free 3-day trial."
	canonical="https://sermonkeeper.app/"
	keywords="sermon notes app, sermon recording app, church notes app, Bible study app, sermon transcription, AI sermon notes, iPhone sermon app, record sermons, timestamped notes, KJV Bible app, Christian app, church app iOS"
	ogTitle="Sermon Keeper - AI-Powered Sermon Notes for iOS"
	ogDescription="Record sermons, take timestamped notes, and get automatic transcription with summary. Works in English and Spanish."
	ogImage="https://sermonkeeper.app/scss/image/og-image.jpg"
	twitterTitle="Sermon Keeper - AI-Powered Sermon Notes for iOS"
	twitterDescription="Record sermons, take timestamped notes, and get automatic transcription with summary. Works in English and Spanish."
	schemas={schemas}
	headerHref={pageAppStoreUrl('landing_home_header')}
	navHref={pageAppStoreUrl('landing_home_nav')}
	active="home"
	headerIsland
	campaign="landing_home"
>
	<!-- Hero: a generated photo with the real app screen composited into the phone (site-drafts/homepage-sugar/composite.py).
	     Cards are HTML so their text stays sharp; they're placed in % of the picture, so the stage keeps its aspect ratio. -->
	<section class="h-hero">
		<div class="h-stage">
			<picture>
				<source media="(max-width: 899px)" type="image/webp" srcset={`${IMG}/hero5-tall-1080.webp`} />
				<source media="(max-width: 899px)" srcset={`${IMG}/hero5-tall-1080.jpg`} />
				<source type="image/webp" srcset={`${IMG}/hero5-wide-1376.webp 1376w, ${IMG}/hero5-wide-2400.webp 2400w`} sizes="100vw" />
				<img class="h-bg" src={`${IMG}/hero5-wide-1376.jpg`} srcset={`${IMG}/hero5-wide-1376.jpg 1376w, ${IMG}/hero5-wide-2400.jpg 2400w`} sizes="100vw"
					alt="A hand holding an iPhone with Sermon Keeper's notes for a sermon over a light-blue table with an open Bible and a blue mug"
					width="2736" height="1766" fetchpriority="high" />
			</picture>
			<!-- the app screen again as its own full-resolution layer, laid over the phone in the photo so it stays sharp when zoomed;
			     corners are fractions of the wide / tall photo (tl, tr, br, bl), from composite.py -->
			<img class="h-screen" src={`${IMG}/screen-hero.webp`} width="1179" height="2556" alt="" aria-hidden="true"
				data-wide="0.41663,0.44649,0.57006,0.44265,0.58224,0.93707,0.42989,0.94315"
				data-tall="0.35845,0.50214,0.63765,0.50214,0.63958,0.80609,0.35845,0.80702" />
			<div class="h-fade" aria-hidden="true"><i></i><i></i><i></i></div>

			<!-- dashed links from the cards to the phone, in % of the picture (100 × 64.5 = 2736 × 1766) -->
			<svg class="h-dash" viewBox="0 0 100 64.5" preserveAspectRatio="none" aria-hidden="true">
				<path d="M30.5 37 C 34 32, 38 33, 40.5 37.5" />
				<path d="M59 33 C 60.5 29.5, 62.5 29, 64 31" />
				<path d="M59 49 C 61.5 51, 64 51, 66 49.5" />
			</svg>

			<div class="h-copy">
				<h1>Never lose a sermon again</h1>
				<p>Record the sermon, tap short notes, get a summary with every verse the pastor named</p>
				<a href={pageAppStoreUrl('landing_home_hero')} class="h-btn h-btn-light" data-hero-cta><AppleIcon class="h-btn-ico" />Start free trial</a>
				<span class="h-note">Free 3-day trial · No account needed</span>
			</div>

			<div class="h-card c1" aria-hidden="true">
				<img class="h-obj" src={`${IMG}/p-mic.webp`} alt="" width="256" height="256" />
				<span class="h-lab red"><i class="h-rec">●</i> Recording</span><b>38:05</b><small>Every note keeps its minute</small>
			</div>
			<div class="h-card c2" aria-hidden="true">
				<img class="h-obj" src={`${IMG}/p-spark.webp`} alt="" width="256" height="256" />
				<span class="h-lab gold">Summary ready</span><b>Transcript and outline</b><small>With every verse the pastor named</small>
			</div>
			<div class="h-card c3" aria-hidden="true">
				<img class="h-obj" src={`${IMG}/p-book.webp`} alt="" width="256" height="256" />
				<span class="h-lab blue">Verse found</span><b class="h-typed">Genesis 5:24<i></i></b><small>The full verse fills in by itself</small>
			</div>
		</div>
	</section>

	<section class="h-why" data-reveal>
		<div class="h-why-card">
			<h2>Why Sermon<br />Keeper?</h2>
			<p>By Wednesday, Sunday's sermon is a blur: nobody writes as fast as a pastor speaks. Sermon Keeper keeps the whole message while you tap short notes.</p>
		</div>
	</section>

	<section class="h-ways" id="features">
		<div class="h-ways-in">
			<div class="w-icons" data-reveal aria-hidden="true">
				<div class="w-ic"><img src={`${IMG}/p-mic.webp`} alt="" width="256" height="256" /><span>Record</span></div>
				<div class="w-ic on"><img src={`${IMG}/p-note.webp`} alt="" width="256" height="256" /><span>Summary</span></div>
				<div class="w-ic"><img src={`${IMG}/p-book.webp`} alt="" width="256" height="256" /><span>Verses</span></div>
			</div>
			<h2 data-reveal><span>One sermon,</span><br />kept three ways</h2>
			<div class="h-grid">
				<article class="h-feat" data-reveal>
					<span class="w-tag">01 · Record</span>
					<h3>Tap. Replay.</h3>
					<p>Every note is pinned to the audio. Tap one and hear the pastor say it again.</p>
					<div class="h-shot"><video src={`${IMG}/how-record.mp4`} poster={`${IMG}/how-record.webp`} autoplay muted loop playsinline preload="none" width="720" height="1566" aria-label="Screen recording: typing two notes during a recording in Sermon Keeper, each gets its minute"></video></div>
				</article>
				<article class="h-feat on" data-reveal>
					<span class="w-tag">02 · Summary</span>
					<h3>Read. Done.</h3>
					<p>After the service you get a transcript, a short summary, the pastor's outline and questions to reflect on.</p>
					<div class="h-shot"><video src={`${IMG}/how-summary.mp4`} poster={`${IMG}/how-summary.webp`} autoplay muted loop playsinline preload="none" width="720" height="1566" aria-label="Screen recording: scrolling Sermon Keeper's Summary tab from the summary to the outline"></video></div>
				</article>
				<article class="h-feat" data-reveal>
					<span class="w-tag">03 · Verses</span>
					<h3>Named. Found.</h3>
					<p>Every verse the pastor named, in full, in seven Bible translations that work offline.</p>
					<div class="h-shot"><video src={`${IMG}/how-verses.mp4`} poster={`${IMG}/how-verses.webp`} autoplay muted loop playsinline preload="none" width="720" height="1566" aria-label="Screen recording: scrolling Sermon Keeper's Verses tab through the KJV verses the pastor named"></video></div>
				</article>
			</div>
		</div>
	</section>

	<section class="h-bento">
		<div class="b-wide" data-reveal>
			<div class="b-wide-copy">
				<h2>Sunday's sermon,<br />back on Wednesday</h2>
				<p>Pick your service day, and Sermon Keeper reminds you to record an hour before it starts. Three days later, it brings back that sermon's summary.</p>
				<a href={pageAppStoreUrl('landing_home_bento')} class="h-btn">Try it now</a>
			</div>
			<div class="b-shot"><video src={`${IMG}/recap-3.mp4`} poster={`${IMG}/recap-3.webp`} autoplay muted loop playsinline preload="none" width="720" height="1566" aria-label="Screen recording: the Your sermon recap notification opens the sermon's summary in Sermon Keeper"></video></div>
		</div>
		<div class="b-photo" data-reveal>
			<img class="b-photo-bg" src={`${IMG}/ugc-church-d.webp`} alt="A woman with a ponytail in a yellow sweater raising her phone toward the screen at the front of a church" width="1600" height="1200" loading="lazy" decoding="async" />
			<div class="b-photo-blur" aria-hidden="true"><i></i><i></i><i></i></div>
			<div class="b-photo-copy">
				<h2>Point your camera<br />at the slide</h2>
				<p>The pastor puts a quote on the screen? Scan it, and the text lands in your notes. It's read on your phone, offline.</p>
			</div>
		</div>
		<div class="b-grey" data-reveal>
			<h2>Snap a Bible page,<br />get a study card</h2>
			<p>Tap a verse, and Sermon Keeper adds the context, an observation, how to apply it and a prayer.</p>
			<div class="b-scan">
				<img class="b-scan-phone" src={`${IMG}/scan-phone-card.webp`} alt="An iPhone showing a Sermon Keeper study card for Genesis 1:1: Scripture, word study, context, observation, meaning and application" width="1400" height="1391" loading="lazy" decoding="async" />
				<i class="b-scan-shadow" aria-hidden="true"></i>
				<img class="b-scan-book" src={`${IMG}/scan-icon-2.webp`} alt="" width="640" height="560" loading="lazy" decoding="async" />
			</div>
		</div>
	</section>

	<section class="h-oba" id="how">
		<div class="h-oba-head" data-reveal>
			<h2>“Turn to Obadiah”</h2>
			<p>The pastor says it and keeps going. Type the reference in Sermon Keeper while it records, and the full verse appears in your notes.</p>
		</div>
		<div class="h-oba-stage">
			<div class="h-bubbles left" aria-hidden="true">{BUBBLES_L.map((b) => <span>{b}</span>)}</div>
			<div class="h-phone">
				<video src={`${IMG}/obadiah-2.mp4`} poster={`${IMG}/obadiah-2-poster.webp`} autoplay muted loop playsinline preload="none" width="540" height="1174" aria-label="Screen recording: typing Obadiah 1:15 into Sermon Keeper during a recording shows the full verse"></video>
				<img class="h-phone-frame" src={`${IMG}/phone-front.webp`} alt="" width="665" height="1439" loading="lazy" decoding="async" />
			</div>
			<div class="h-bubbles right" aria-hidden="true">{BUBBLES_R.map((b) => <span>{b}</span>)}</div>
		</div>
		<div class="h-oba-cta"><a href={pageAppStoreUrl('landing_home_obadiah')} class="h-btn"><AppleIcon class="h-btn-ico" />Try it free</a></div>
	</section>

	<section class="h-more">
		<h2 data-reveal>More than a recorder</h2>
		<div class="h-grid">
			<article class="m-card m1" data-reveal>
				<h3>Upload a recording</h3>
				<p>Missed the live service? Upload the church's audio file: MP3, M4A or WAV, up to 3 hours.</p>
				<img class="m-pic m-pic-sm" src={`${IMG}/more-upload-line-2.webp`} alt="MP3, M4A and WAV files dropping into a box with the Sermon Keeper logo" width="696" height="900" loading="lazy" decoding="async" />
			</article>
			<article class="m-card m2" data-reveal>
				<h3>Mark it up</h3>
				<p>Bold, lists and highlights in four colors, right in your notes while the sermon records.</p>
				<img class="m-pic" src={`${IMG}/more-markup.webp`} alt="Notes in Sermon Keeper with phrases highlighted in yellow, pink and blue, above the bold, highlight, list and scan buttons" width="1000" height="934" loading="lazy" decoding="async" />
			</article>
			<article class="m-card m3" data-reveal>
				<h3>English or Spanish</h3>
				<p>Notes, transcript and summary in your language. The app speaks Spanish too.</p>
				<img class="m-pic" src={`${IMG}/more-languages-3.webp`} alt="A sermon transcript in English and the same transcript in Spanish" width="980" height="1304" loading="lazy" decoding="async" />
			</article>
		</div>
	</section>

	<section class="h-faq" id="faq">
		<h2 data-reveal>Frequently asked questions</h2>
		<div class="h-faq-list">
			{HOME_FAQ.map((q, i) => (
				<details class="h-q" open={i === 0}>
					<summary><span>{q.question}</span><i aria-hidden="true"></i></summary>
					<p>{q.answer}</p>
				</details>
			))}
		</div>
	</section>

	<HomeBlogTeaser />

	<FinalBanner ct="landing_home_final" />
</BaseLayout>

<script is:inline>
	(function () {
		// Lay the sharp screen over the phone in the hero photo: map its rectangle onto the four screen corners
		// with a perspective matrix, recomputed whenever the photo is resized or swapped (wide ↔ tall).
		var bg = document.querySelector('.h-bg'), scr = document.querySelector('.h-screen');
		if (!bg || !scr) return;
		function place() {
			if (!bg.naturalWidth) return;
			var q = scr.dataset[/tall/.test(bg.currentSrc) ? 'tall' : 'wide'].split(',').map(Number);
			// where object-fit: cover actually draws the photo inside the img box
			var W = bg.clientWidth, H = bg.clientHeight, nw = bg.naturalWidth, nh = bg.naturalHeight;
			var k = Math.max(W / nw, H / nh), dw = nw * k, dh = nh * k;
			var pos = getComputedStyle(bg).objectPosition.split(' ').map(parseFloat);
			var ox = bg.offsetLeft + (W - dw) * pos[0] / 100, oy = bg.offsetTop + (H - dh) * pos[1] / 100;
			var x = [], y = [];
			for (var i = 0; i < 4; i++) { x.push(ox + q[2 * i] * dw); y.push(oy + q[2 * i + 1] * dh); }
			// unit square → quad (Heckbert), then scaled down from the screen's own size
			var dx1 = x[1] - x[2], dx2 = x[3] - x[2], dx3 = x[0] - x[1] + x[2] - x[3];
			var dy1 = y[1] - y[2], dy2 = y[3] - y[2], dy3 = y[0] - y[1] + y[2] - y[3];
			var den = dx1 * dy2 - dx2 * dy1;
			var g = (dx3 * dy2 - dx2 * dy3) / den, h = (dx1 * dy3 - dx3 * dy1) / den;
			var a = x[1] - x[0] + g * x[1], b = x[3] - x[0] + h * x[3], c = x[0];
			var d = y[1] - y[0] + g * y[1], e = y[3] - y[0] + h * y[3], f = y[0];
			var w = scr.offsetWidth, ht = scr.offsetHeight;
			a /= w; d /= w; g /= w; b /= ht; e /= ht; h /= ht;
			scr.style.transform = 'matrix3d(' + [a, d, 0, g, b, e, 0, h, 0, 0, 1, 0, c, f, 0, 1].join(',') + ')';
			scr.classList.add('on');
		}
		bg.addEventListener('load', place);
		if (bg.complete) place();
		if ('ResizeObserver' in window) new ResizeObserver(place).observe(bg);
	})();
	(function () {
		// FAQ answers slide open and closed instead of jumping (skipped for reduced motion: the native toggle stays).
		if (!Element.prototype.animate || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		document.querySelectorAll('.h-q').forEach(function (q) {
			var body = q.querySelector('p'), anim = null;
			q.querySelector('summary').addEventListener('click', function (e) {
				e.preventDefault();
				if (anim) anim.cancel();
				var closing = q.open;
				// opening waits a frame so the click sound still reads the item as closed
				requestAnimationFrame(function () {
					q.open = true;
					var cs = getComputedStyle(body), full = { height: body.scrollHeight + 'px', opacity: 1, marginBottom: cs.marginBottom };
					var none = { height: '0px', opacity: 0, marginBottom: '0px' };
					body.style.overflow = 'hidden';
					anim = body.animate(closing ? [full, none] : [none, full], { duration: closing ? 220 : 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
					anim.onfinish = function () { anim = null; body.style.overflow = ''; if (closing) q.open = false; };
				});
			});
		});
	})();
	(function () {
		// Fade sections in as they scroll into view (skipped for reduced motion / old browsers: content just shows).
		var els = document.querySelectorAll('[data-reveal]');
		if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		document.documentElement.classList.add('h-anim');
		var io = new IntersectionObserver(function (es) {
			es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
		}, { rootMargin: '0px 0px -10% 0px' });
		els.forEach(function (el) { io.observe(el); });
	})();
</script>

<style>
	.h-hero { background: #B9D3F5; }
	.h-stage { position: relative; aspect-ratio: 2736 / 1766; overflow: hidden; }
	.h-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.h-screen { position: absolute; left: 0; top: 0; width: 1179px; height: 2556px; max-width: none; transform-origin: 0 0; border-radius: 165px; opacity: 0; pointer-events: none; }
	.h-screen.on { opacity: 1; }
	/* the photo melts into the white page: three blur layers, each stronger and starting lower, so there is
	   no edge where the blur begins; then a fade to white */
	.h-fade { position: absolute; left: 0; right: 0; bottom: 0; height: clamp(160px, 22%, 300px); z-index: 1; pointer-events: none; }
	.h-fade i { position: absolute; inset: 0; }
	.h-fade i:nth-child(1) { backdrop-filter: blur(3px); mask-image: linear-gradient(to bottom, transparent, #000 40%); }
	.h-fade i:nth-child(2) { backdrop-filter: blur(8px); mask-image: linear-gradient(to bottom, transparent 25%, #000 65%); }
	.h-fade i:nth-child(3) { backdrop-filter: blur(16px); mask-image: linear-gradient(to bottom, transparent 50%, #000 90%); }
	.h-fade::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(255,255,255,0) 20%, rgba(255,255,255,.6) 70%, #fff); }
