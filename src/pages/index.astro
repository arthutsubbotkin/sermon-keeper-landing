---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBlogTeaser from '../components/HomeBlogTeaser.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { pageAppStoreUrl } from '../utils/site';
import { faqSchema } from '../utils/seo';

const schemas = [
 {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sermon Keeper",
  "alternateName": "Sermon Keeper - Smart Notes",
  "description": "AI-powered sermon notes app for iOS. Record sermons, take timestamped notes, get automatic transcription with summary and key points. Built specifically for churchgoers who want to remember every sermon.",
  "url": "https://sermonkeeper.app",
  "operatingSystem": "iOS",
  "applicationCategory": "ReligionApplication",
  "offers": [
   {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free 3-day trial"
   },
   {
    "@type": "Offer",
    "price": "6.99",
    "priceCurrency": "USD",
    "description": "Monthly subscription for unlimited recordings"
   },
   {
    "@type": "Offer",
    "price": "64.99",
    "priceCurrency": "USD",
    "description": "Annual subscription for unlimited recordings"
   }
  ],
  "featureList": [
   "One-tap sermon recording in high quality audio",
   "Timestamped notes synced to audio playback",
   "Bible verse autocomplete (KJV)",
   "AI-powered speech-to-text transcription",
   "Automatic sermon summary with key points",
   "iCloud sync across devices",
   "English and Spanish support",
   "No account required"
  ],
  "screenshot": "https://sermonkeeper.app/scss/image/og-image.jpg",
  "installUrl": "https://apps.apple.com/app/apple-store/id6758739935?pt=128512327&ct=landing_page&mt=8",
  "author": {
   "@type": "Organization",
   "name": "Sermon Keeper",
   "url": "https://sermonkeeper.app",
   "email": "hello@sermonkeeper.app",
   "sameAs": [
    "https://apps.apple.com/app/apple-store/id6758739935",
    "https://www.wikidata.org/wiki/Q140811548"
   ]
  },
  "inLanguage": [
   "en",
   "es"
  ]
 },
 {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sermon Keeper",
  "url": "https://sermonkeeper.app",
  "description": "AI-powered sermon notes app for iOS. Record, transcribe, and never miss an insight from your church sermons.",
  "publisher": {
   "@type": "Organization",
   "name": "Sermon Keeper",
   "url": "https://sermonkeeper.app",
   "logo": {
    "@type": "ImageObject",
    "url": "https://sermonkeeper.app/apple-touch-icon.png"
   }
  }
 }
];
// Homepage FAQ, rendered with the same accordion the articles use.
const HOME_FAQ = [
 {
  "question": "What is Sermon Keeper?",
  "answer": "An iOS app that records sermons, adds timestamps to your notes, and gives you automatic transcription with summary."
 },
 {
  "question": "Is Sermon Keeper free?",
  "answer": "Free 3-day trial on the yearly plan, then $6.99/month or $64.99/year for unlimited recordings and transcriptions."
 },
 {
  "question": "What languages are supported?",
  "answer": "English and Spanish — both the app and AI transcription."
 },
 {
  "question": "What Bible version is used?",
  "answer": "King James Version (KJV) for now. More translations coming soon."
 },
 {
  "question": "Can I share my notes?",
  "answer": "Yes — export via email or plain text."
 },
 {
  "question": "Best app to record sermons on iPhone?",
  "answer": "Sermon Keeper is built specifically for church — with timestamped notes, Bible verses, and AI summaries."
 },
 {
  "question": "Will I lose my recordings?",
  "answer": "No — recordings live on your device, and your notes sync to your personal iCloud automatically."
 },
 {
  "question": "Do I need an account?",
  "answer": "No sign-up required. Just download and start recording."
 },
 {
  "question": "Is my data secure?",
  "answer": "Your notes sync through your own personal iCloud, not our servers. The audio you record is sent to our server only to create the transcript, then deleted. We don't sell your data."
 }
];
// FAQPage schema is generated from the same HOME_FAQ the visible accordion renders,
// so the two can never drift (Google drops FAQ rich results when they do).
schemas.splice(1, 0, faqSchema(HOME_FAQ));

const BODY_TOP = `<!-- Hero Section -->

	<div class="hero-section">

		<div class="hero-content">

			<div class="hero-badge">iOS App</div>

			<h1 class="hero-title">AI-Powered <span class="gradient-text">Sermon Notes</span> for iOS — Record, Transcribe & Never Miss an Insight</h1>

			<p class="hero-subtitle">

				Record sermons, take timestamped notes, and get automatic transcription with summary. Works in English and Spanish.

			</p>

			<a href="${pageAppStoreUrl('landing_home_hero')}" class="app-store-btn">

				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>

				Download on App Store

			</a>

		</div>

	</div>



	<!-- Features Section -->

	<div class="features-section">

		<div class="features-container">

			<div class="features-grid">

				<div class="feature-card">

					<h3>Record your sermons</h3>

					<p>Tap once to start recording. Your sermon is captured in high quality audio, ready for notes and transcription.</p>

					<img src="scss/image/recordyoursermons.webp" alt="Record your sermons" loading="lazy" decoding="async" />

				</div>

				<div class="feature-card">

					<h3>Timestamp your notes</h3>

					<p>Add notes anytime during recording. Each note saves the exact timestamp for easy reference later.</p>

					<img src="scss/image/timestampyournotes.webp" alt="Timestamp your notes" loading="lazy" decoding="async" />

				</div>

				<div class="feature-card">

					<h3>Autocomplete Bible verses</h3>

					<p>Type any reference like John 3:16 and instantly see the full verse text in a beautiful card.</p>

					<img src="scss/image/autocomplete.webp" alt="Autocomplete Bible verses" loading="lazy" decoding="async" />

				</div>

				<div class="feature-card">

					<h3>AI-powered transcription</h3>

					<p>After recording, get automatic speech-to-text transcription with organized summary and key points.</p>

					<img src="scss/image/AI-powered transcription.webp" alt="AI-powered transcription" loading="lazy" decoding="async" />

				</div>

			</div>

		</div>

	</div>



	<!-- Perfect For Section -->

	<div class="struggle-section">

		<div class="struggle-container">

			<h2>Perfect for</h2>

			<div class="struggle-grid">

				<div class="struggle-card">

					<img src="scss/image/busy-church-goers.webp" alt="Busy church-goers" loading="lazy" decoding="async" />

					<div class="struggle-card-content">

						<h5>Busy church-goers</h5>

						<p>You want to remember the sermon but can't take detailed notes during service</p>

					</div>

				</div>

				<div class="struggle-card">

					<img src="scss/image/bible-study-groups.webp" alt="Bible study groups" loading="lazy" decoding="async" />

					<div class="struggle-card-content">

						<h5>Bible study groups</h5>

						<p>Share accurate sermon notes with your group without retyping everything</p>

					</div>

				</div>

				<div class="struggle-card">

					<img src="scss/image/new-believers.webp" alt="New believers" loading="lazy" decoding="async" />

					<div class="struggle-card-content">

						<h5>New believers</h5>

						<p>Catch every Bible reference the pastor mentions, even if you don't know where to find it yet</p>

					</div>

				</div>

			</div>

		</div>

	</div>



	`;
const BODY_BOTTOM = `<!-- CTA Section -->

	<div class="cta-section">

		<div class="cta-container">

			<div class="cta-content">

				<h2>Start capturing sermons today — simple, fast, and yours</h2>

				<p>Download Sermon Keeper and never miss an insight from your next sermon.</p>

				<a href="${pageAppStoreUrl('landing_home_final')}" class="app-store-btn">

				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>

				Download on App Store

			</a>

			</div>

			<div class="cta-image">

				<img src="scss/image/Start capturing sermons today — simple, fast, and private.webp" alt="Sermon Keeper App" loading="lazy" decoding="async" />

			</div>

		</div>

	</div>`;
---

<BaseLayout
	title="Sermon Keeper: AI Sermon Notes & Recording App for iPhone"
	description="Record sermons, take timestamped notes, and get automatic AI transcription with a summary. The sermon notes app for iPhone. Free 3-day trial."
	canonical="https://sermonkeeper.app/"
	keywords="sermon notes app, sermon recording app, church notes app, Bible study app, sermon transcription, AI sermon notes, iPhone sermon app, record sermons, timestamped notes, KJV Bible app, Christian app, church app iOS"
	ogTitle="Sermon Keeper - AI-Powered Sermon Notes for iOS"
	ogDescription="Record sermons, take timestamped notes, and get automatic transcription with summary. Works in English and Spanish."
	ogImage="https://sermonkeeper.app/scss/image/og-image.jpg"
	twitterTitle="Sermon Keeper - AI-Powered Sermon Notes for iOS"
	twitterDescription="Record sermons, take timestamped notes, and get automatic transcription with summary. Works in English and Spanish."
	schemas={schemas}
	headerHref={pageAppStoreUrl('landing_home_header')}
	navHref={pageAppStoreUrl('landing_home_nav')}
	active="home"
>
	<Fragment set:html={BODY_TOP} />

	<div class="faq-section">
		<div class="faq-container">
			<h2>Frequently Asked Questions</h2>
			<FAQAccordion faq={HOME_FAQ} />
		</div>
	</div>

	<HomeBlogTeaser />
	<Fragment set:html={BODY_BOTTOM} />

</BaseLayout>
