---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import ArticleCTA from '../../components/ArticleCTA.astro';
import ArticleBanner from '../../components/ArticleBanner.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Components the MDX bodies can use inline, so mid-article CTAs and the divider
// banner stay where the original hand-written HTML had them.
const components = { ArticleCTA, ArticleBanner };
---

<BlogPost post={post} slug={post.id}>
	<Content components={components} />
</BlogPost>
