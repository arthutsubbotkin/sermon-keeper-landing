---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageAppStoreUrl } from '../utils/site';

const schemas = [
 {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
   {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://sermonkeeper.app/"
   },
   {
    "@type": "ListItem",
    "position": 2,
    "name": "Terms of Service"
   }
  ]
 }
];
const BODY = `<!-- Article Hero -->
	<div class="article-hero">
		<div class="article-hero-inner">
			<div class="article-breadcrumb"><a href="/">Home</a> &rarr; Terms of Service</div>
			<h1>Terms of Service for Sermon Keeper</h1>
			<div class="article-meta">Last updated: February 25, 2026</div>
		</div>
	</div>

	<!-- Article Body -->
	<div class="article-body">
		<div class="article-content">

			<p>Please read these Terms of Service ("Terms") carefully before using the Sermon Keeper mobile application ("App"). By using the App, you agree to be bound by these Terms. If you do not agree, do not use the App.</p>

			<h2>1. About the Service</h2>

			<p>Sermon Keeper is a mobile application that allows you to:</p>
			<ul>
				<li>Record sermons and add timestamped notes</li>
				<li>Get AI-powered transcription and summaries</li>
				<li>Automatically link Bible verses</li>
				<li>Store and organize your sermon recordings</li>
			</ul>

			<h2>2. Account</h2>

			<p>To use certain features, you may sign in using Sign in with Apple. You are responsible for maintaining the security of your account and for all activities that occur under your account.</p>

			<h2>3. Subscription and Payments</h2>

			<p><strong>Free Plan</strong></p>
			<ul>
				<li>3 sermon recordings in total</li>
				<li>Full transcription and summary features within the limit</li>
			</ul>

			<p><strong>Paid Plans</strong></p>
			<ul>
				<li>Monthly: $6.99 per month</li>
				<li>Yearly: $64.99 per year</li>
			</ul>

			<p><strong>Billing</strong></p>
			<ul>
				<li>Payments are processed by Apple through In-App Purchase</li>
				<li>Subscriptions automatically renew unless cancelled at least 24 hours before the end of the current period</li>
				<li>Your Apple ID account will be charged for renewal within 24 hours prior to the end of the current period</li>
			</ul>

			<p><strong>How to Cancel</strong></p>
			<p>Go to Settings &rarr; Apple ID &rarr; Subscriptions &rarr; Sermon Keeper &rarr; Cancel Subscription</p>

			<p><strong>Refunds</strong></p>
			<p>All refund requests are handled by Apple. To request a refund, visit <a href="https://reportaproblem.apple.com" target="_blank" rel="noopener">https://reportaproblem.apple.com</a></p>

			<h2>4. How Your Data Is Processed</h2>

			<p>To provide transcription and summary features, your data is processed as follows:</p>
			<ul>
				<li><strong>Audio recordings</strong> are temporarily uploaded to secure cloud storage solely for the purpose of transcription. Audio files are automatically deleted from cloud storage after processing is complete.</li>
				<li><strong>Transcription</strong> is performed by a third-party speech-to-text service. Your audio is transmitted to their servers for processing.</li>
				<li><strong>AI summaries</strong> are generated by a third-party AI service. Only the transcribed text (not audio) is sent for summarization.</li>
				<li><strong>Original recordings and notes</strong> remain stored locally on your device under your control.</li>
			</ul>

			<p>We do not sell, share, or use your data for advertising purposes. Third-party services process your data solely to provide the App's features.</p>

			<h2>5. Acceptable Use</h2>

			<p>You agree NOT to:</p>
			<ul>
				<li>Use the App for any illegal purpose</li>
				<li>Record content without proper consent from others</li>
				<li>Attempt to hack, reverse engineer, or disrupt the App</li>
				<li>Abuse the service or use it in ways that harm other users</li>
				<li>Upload malicious content or malware</li>
			</ul>

			<p>We reserve the right to suspend or terminate your access if you violate these rules.</p>

			<h2>6. Your Content</h2>

			<ul>
				<li>You own all recordings, notes, and content you create</li>
				<li>We do not claim ownership of your content</li>
				<li>You grant us permission to process your content solely to provide the service (transcription, summaries, etc.)</li>
				<li>You are responsible for backing up your own data</li>
			</ul>

			<h2>7. Disclaimer of Warranties</h2>

			<p>The App is provided "as is" without warranties of any kind.</p>

			<p>We do NOT guarantee:</p>
			<ul>
				<li>100% accuracy of transcriptions or summaries</li>
				<li>Uninterrupted or error-free service</li>
				<li>That the App will meet all your requirements</li>
			</ul>

			<p>AI-generated content may contain errors. Always verify important information.</p>

			<h2>8. Limitation of Liability</h2>

			<p>To the maximum extent permitted by law:</p>
			<ul>
				<li>We are not liable for any indirect, incidental, or consequential damages</li>
				<li>We are not liable for loss of data, recordings, or content</li>
				<li>Our total liability shall not exceed the amount you paid for the subscription in the past 12 months</li>
			</ul>

			<h2>9. Termination</h2>

			<p><strong>By You</strong></p>
			<p>You may stop using the App at any time. Delete the App to remove all local data.</p>

			<p><strong>By Us</strong></p>
			<p>We may suspend or terminate your access if you violate these Terms. We will try to notify you, but are not required to do so.</p>

			<h2>10. Changes to Terms</h2>

			<p>We may update these Terms from time to time. Changes will be posted within the App with an updated "Last updated" date. Continued use after changes means you accept the new Terms.</p>

			<h2>11. Governing Law</h2>

			<p>These Terms shall be governed by the laws of the State of Delaware, USA, without regard to conflict of law principles.</p>

			<p>Any disputes arising from these Terms shall be resolved in the courts of Delaware, USA.</p>

			<h2>12. Contact Us</h2>

			<p>If you have questions about these Terms, please contact us:</p>

			<p><strong>Email:</strong> <a href="mailto:hello@sermonkeeper.app">hello@sermonkeeper.app</a></p>

			<p>These Terms of Service are effective as of February 25, 2026.</p>

		</div>
	</div>`;
---

<BaseLayout
	title="Terms of Service | Sermon Keeper"
	description="Terms of Service for Sermon Keeper — the rules and guidelines for using our iOS sermon recording and transcription app."
	canonical="https://sermonkeeper.app/terms"
	author="Sermon Keeper"
	ogType="website"
	ogTitle="Terms of Service | Sermon Keeper"
	ogDescription="Terms of Service for Sermon Keeper — the rules and guidelines for using our app."
	ogImage="https://sermonkeeper.app/scss/image/og-image.png"
	twitterTitle="Terms of Service | Sermon Keeper"
	twitterDescription="Terms of Service for Sermon Keeper — the rules and guidelines for using our app."
	schemas={schemas}
	headerHref={pageAppStoreUrl("landing_page")}
	navHref={pageAppStoreUrl("landing_page")}
>
	<Fragment set:html={BODY} />
</BaseLayout>
