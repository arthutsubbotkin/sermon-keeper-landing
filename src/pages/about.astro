---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageAppStoreUrl } from '../utils/site';

const schemas = [
 {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Sermon Keeper",
  "url": "https://sermonkeeper.app/about",
  "description": "About Sermon Keeper — the team behind the iOS app that helps churchgoers record, transcribe, and remember sermons.",
  "mainEntity": {
   "@type": "Organization",
   "name": "Sermon Keeper",
   "url": "https://sermonkeeper.app",
   "logo": {
    "@type": "ImageObject",
    "url": "https://sermonkeeper.app/apple-touch-icon.png"
   },
   "email": "hello@sermonkeeper.app",
   "description": "Sermon Keeper is an iOS app for church-going Christians who want to record, transcribe, and remember sermons — with timestamped notes, AI transcription, offline Bible verse autocomplete, and SOAP study cards.",
   "sameAs": [
    "https://apps.apple.com/app/apple-store/id6758739935",
    "https://www.wikidata.org/wiki/Q140811548"
   ],
   "employee": [
    {
     "@type": "Person",
     "name": "Maya Ellison",
     "jobTitle": "Product Writer"
    },
    {
     "@type": "Person",
     "name": "Daniel Osei",
     "jobTitle": "Bible Study Writer"
    },
    {
     "@type": "Person",
     "name": "Grace Whitfield",
     "jobTitle": "Sermon Notes Writer"
    }
   ]
  }
 },
 {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
   {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://sermonkeeper.app/"
   },
   {
    "@type": "ListItem",
    "position": 2,
    "name": "About"
   }
  ]
 }
];
const BODY = `<!-- Hero -->
	<div class="article-hero">
		<div class="article-hero-inner">
			<div class="article-breadcrumb"><a href="/">Home</a> &rarr; About</div>
			<h1>About Sermon Keeper</h1>
			<div class="article-meta">Made for people who don't want to lose the sermon</div>
		</div>
	</div>

	<!-- Body -->
	<div class="article-body">
		<div class="article-content">
			<p class="about-lead">Sermon Keeper is an iOS app for church-going Christians who want to capture, remember, and reflect on the sermon — without spending the whole service with their head down, scribbling.</p>

			<p>The idea is simple. You record the message in one tap, drop timestamped notes whenever something lands, and when the service ends the app transcribes the whole thing — with a summary, the key points, and any Bible references the pastor mentioned. Your notes sync to your own iCloud, so they stay yours, and Bible verse autocomplete works offline (KJV).</p>

			<p>We built it because the tools people were using — a voice memo here, a half-page of notes there — left the best parts of Sunday scattered and quickly forgotten. Sermon Keeper keeps the recording, your notes, the transcript, and even a <a href="/blog/soap-bible-study-method">SOAP study card</a> in one place, so the message is still with you on Tuesday.</p>

			<h2>The people behind the writing</h2>

			<p>Our guides are written by a small team who care about getting both the faith and the details right. Between them they cover the product, the practice of note-taking, and Bible study itself.</p>

			<div class="about-authors">
				<div class="about-author-card">
					<img src="scss/image/blog/authors/maya-ellison.jpg" alt="Maya Ellison" width="72" height="72" loading="lazy" decoding="async" />
					<div>
						<h3>Maya Ellison</h3>
						<div class="about-author-role">Product Writer</div>
						<p>Maya writes about the tools churchgoers actually use. She has spent years testing note-taking and productivity apps, and covers the product and how-to side of Sermon Keeper — recording, transcription, and getting more out of every service.</p>
					</div>
				</div>
				<div class="about-author-card">
					<img src="scss/image/blog/authors/daniel-osei.jpg" alt="Daniel Osei" width="72" height="72" loading="lazy" decoding="async" />
					<div>
						<h3>Daniel Osei</h3>
						<div class="about-author-role">Bible Study Writer</div>
						<p>Daniel writes about Scripture and the habits that help it stick. He's drawn to the practical side of discipleship — moving from hearing the Word on Sunday to living it during the week — and covers study methods like SOAP.</p>
					</div>
				</div>
				<div class="about-author-card">
					<img src="scss/image/blog/authors/grace-whitfield.jpg" alt="Grace Whitfield" width="72" height="72" loading="lazy" decoding="async" />
					<div>
						<h3>Grace Whitfield</h3>
						<div class="about-author-role">Sermon Notes Writer</div>
						<p>Grace writes about the practical craft of taking and keeping sermon notes. A lifelong note-taker, she focuses on the methods, habits, and small decisions that turn a passing Sunday message into something you remember.</p>
					</div>
				</div>
			</div>

			<h2>What we believe about your data</h2>

			<p>Your sermons are personal, and they stay that way. Your recordings and notes live on your device and sync only to your own iCloud — we don't store them on our servers or sell your data. Audio is sent securely for transcription and deleted from our server afterward. We have no access to your notes and recordings. You can read the full detail in our <a href="/privacy">Privacy Policy</a>.</p>

			<div class="final-banner">
				<div class="final-banner-media" aria-hidden="true">
					<picture>
						<source srcset="/scss/image/blog/banner/phone.webp?v=2" type="image/webp" />
						<img src="/scss/image/blog/banner/phone.png?v=2" alt="" width="938" height="1256" loading="lazy" decoding="async" />
					</picture>
				</div>
				<div class="final-banner-body">
					<h3>Keep every sermon</h3>
					<p>Record, transcribe, and revisit any message, all from your iPhone. Free for 3 days.</p>
					<ul class="final-banner-features">
						<li><span class="final-banner-ic">🎙️</span> One-tap recording</li>
						<li><span class="final-banner-ic">⏱️</span> Timestamped notes</li>
						<li><span class="final-banner-ic">✨</span> AI transcript &amp; summary</li>
						<li><span class="final-banner-ic">🔒</span> Notes sync via your iCloud</li>
					</ul>
					<a href="https://apps.apple.com/app/apple-store/id6758739935?pt=128512327&amp;ct=landing_about_final&amp;mt=8" class="final-banner-btn">Try free for 3 days</a>
				</div>
			</div>
		</div>
	</div>`;
---

<BaseLayout
	title="About Sermon Keeper | Who We Are"
	description="About Sermon Keeper — the team behind the iOS app that helps churchgoers record, transcribe, and remember sermons, and the writers behind our guides."
	canonical="https://sermonkeeper.app/about"
	author="Sermon Keeper"
	ogType="website"
	ogTitle="About Sermon Keeper | Who We Are"
	ogDescription="The team behind the app that helps churchgoers record, transcribe, and remember sermons — and the writers behind our guides."
	ogImage="https://sermonkeeper.app/scss/image/og-image.png"
	twitterTitle="About Sermon Keeper | Who We Are"
	twitterDescription="The team behind the app that helps churchgoers record, transcribe, and remember sermons."
	schemas={schemas}
	headerHref={pageAppStoreUrl("landing_about_header")}
	navHref={pageAppStoreUrl("landing_about_nav")}
>
	<Fragment set:html={BODY} />
</BaseLayout>
