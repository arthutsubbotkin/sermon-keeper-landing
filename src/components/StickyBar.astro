---
interface Props {
	mobileHref: string;
	/** Omit to render the mobile bar only, as the blog listing has always done. */
	desktopHref?: string;
}
const { mobileHref, desktopHref } = Astro.props;
---

<!-- Sticky mobile CTA bar -->
<a class="sticky-cta" id="stickyCta" href={mobileHref} aria-label="Try free for 3 days with Sermon Keeper">
	<span class="sticky-cta-left">
		<img class="sticky-cta-icon" src="/apple-touch-icon.png" alt="" width="40" height="40" />
		<span class="sticky-cta-text">
			<strong>Sermon Keeper</strong>
			<span>AI sermon notes</span>
		</span>
	</span>
	<span class="sticky-cta-btn">Try free for 3 days</span>
</a>

<!-- Sticky desktop CTA bar (centered pill, appears after 30% scroll) -->
{
	desktopHref && (
		<a
			class="sticky-cta-desktop"
			id="stickyCtaDesktop"
			href={desktopHref}
			aria-label="Try free for 3 days with Sermon Keeper"
		>
			<img
				class="sticky-cta-desktop-icon"
				src="/apple-touch-icon.png"
				alt=""
				width="32"
				height="32"
			/>
			<span class="sticky-cta-desktop-text">Sermon Keeper</span>
			<span class="sticky-cta-desktop-btn">Try free for 3 days</span>
		</a>
	)
}

<script is:inline>
	// Mobile bar shows immediately; desktop pill appears after 30% scroll. Both hide at the footer.
	(function () {
		var mobileBar = document.getElementById('stickyCta');
		var desktopBar = document.getElementById('stickyCtaDesktop');
		var footer = document.querySelector('.footer-section');
		if (!footer) return;
		var footerVisible = false;
		function update() {
			if (mobileBar) mobileBar.classList.toggle('is-hidden', footerVisible);
			if (desktopBar) {
				var docH = document.documentElement.scrollHeight - window.innerHeight;
				var progress = docH > 0 ? window.scrollY / docH : 0;
				desktopBar.classList.toggle('is-visible', progress >= 0.3 && !footerVisible);
			}
		}
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(
				function (entries) {
					entries.forEach(function (e) {
						footerVisible = e.isIntersecting;
					});
					update();
				},
				{ rootMargin: '0px 0px -72px 0px' }
			).observe(footer);
		}
		var ticking = false;
		window.addEventListener(
			'scroll',
			function () {
				if (!ticking) {
					window.requestAnimationFrame(function () {
						update();
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true }
		);
		update();
	})();
</script>
