---
interface Props {
	mobileHref: string;
	/** Omit to render the mobile bar only, as the blog listing has always done. */
	desktopHref?: string;
}
const { mobileHref, desktopHref } = Astro.props;
---

<!-- Sticky mobile CTA: a small floating banner. The logo already sits in the header, so the left side is
     the homepage's 3D note icon and one line about what you get instead of the app name. -->
<a class="sticky-cta" id="stickyCta" href={mobileHref} aria-label="Start a free trial of Sermon Keeper">
	<span class="sticky-cta-left">
		<img class="sticky-cta-icon" src="/scss/image/home/p-note.webp" alt="" width="256" height="256" />
		<span class="sticky-cta-text">
			<strong>Keep every sermon</strong>
			<span>Notes, summary, verses</span>
		</span>
	</span>
	<span class="sticky-cta-btn">Start free trial</span>
</a>

<!-- Sticky desktop CTA bar (centered pill, appears after 30% scroll) -->
{
	desktopHref && (
		<a
			class="sticky-cta-desktop"
			id="stickyCtaDesktop"
			href={desktopHref}
			aria-label="Start a free trial of Sermon Keeper"
		>
			<img
				class="sticky-cta-desktop-icon"
				src="/scss/image/home/p-note.webp"
				alt=""
				width="256"
				height="256"
			/>
			<span class="sticky-cta-desktop-text">Keep every sermon<span> · Notes, summary, verses</span></span>
			<span class="sticky-cta-desktop-btn">Start free trial</span>
		</a>
	)
}

<script is:inline>
	// Mobile bar shows immediately; desktop pill appears after 30% scroll. Both hide at the footer and while the
	// blue closing banner (which has its own button) is on screen.
	(function () {
		var mobileBar = document.getElementById('stickyCta');
		var desktopBar = document.getElementById('stickyCtaDesktop');
		var footer = document.querySelector('.footer-section');
		if (!footer) return;
		var footerVisible = false;
		var seen = new Map();
		function update() {
			if (mobileBar) mobileBar.classList.toggle('is-hidden', footerVisible);
			if (desktopBar) {
				var docH = document.documentElement.scrollHeight - window.innerHeight;
				var progress = docH > 0 ? window.scrollY / docH : 0;
				desktopBar.classList.toggle('is-visible', progress >= 0.3 && !footerVisible);
			}
		}
		if ('IntersectionObserver' in window) {
			var io = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (e) {
						seen.set(e.target, e.isIntersecting);
					});
					footerVisible = Array.from(seen.values()).some(Boolean);
					update();
				},
				{ rootMargin: '0px 0px -72px 0px' }
			);
			io.observe(footer);
			document.querySelectorAll('.h-final').forEach(function (el) { io.observe(el); });
		}
		var ticking = false;
		window.addEventListener(
			'scroll',
			function () {
				if (!ticking) {
					window.requestAnimationFrame(function () {
						update();
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true }
		);
		update();
	})();
</script>
