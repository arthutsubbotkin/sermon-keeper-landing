---
interface Props {
	faq: { question: string; answer: string }[];
}
const { faq } = Astro.props;
---

{
	faq.length > 0 && (
		<div class="faq-accordion">
			{faq.map((item, i) => (
				<div class="faq-acc-item">
					<button
						class="faq-acc-q"
						id={`faq-q-${i + 1}`}
						aria-expanded="false"
						aria-controls={`faq-a-${i + 1}`}
					>
						<span>{item.question}</span>
						{/* Plus that turns into a minus: only the vertical bar collapses. */}
						<svg class="faq-acc-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<line x1="4" y1="12" x2="20" y2="12" />
							<line class="faq-acc-icon-bar" x1="12" y1="4" x2="12" y2="20" />
						</svg>
					</button>
					<div
						class="faq-acc-a"
						id={`faq-a-${i + 1}`}
						role="region"
						aria-labelledby={`faq-q-${i + 1}`}
					>
						<p>{item.answer}</p>
					</div>
				</div>
			))}
		</div>
	)
}

<script is:inline>
	// Open/close is driven by CSS off aria-expanded; the script only flips the attribute.
	(function () {
		document.querySelectorAll('.faq-acc-q').forEach(function (btn) {
			btn.addEventListener('click', function () {
				btn.setAttribute(
					'aria-expanded',
					btn.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'
				);
			});
		});
	})();
</script>
