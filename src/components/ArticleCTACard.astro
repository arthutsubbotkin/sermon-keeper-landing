---
interface Props {
	heading: string;
	text: string;
	href: string;
	pills?: string[];
	imageAlt?: string;
}
// Per-article heading/text/pills inside the mockup's banner layout; the button
// and the fallback feature list stay fixed.
const DEFAULT_FEATURES = [
	{ ic: '🎙️', label: 'One-tap recording' },
	{ ic: '⏱️', label: 'Timestamped notes' },
	{ ic: '✨', label: 'AI transcript & summary' },
	{ ic: '🔒', label: 'Notes sync via your iCloud' },
];
const { href, heading, text, pills } = Astro.props;
const features = pills?.length ? pills.map((p) => ({ ic: '✓', label: p })) : DEFAULT_FEATURES;
---

<div class="final-banner">
	<div class="final-banner-media" aria-hidden="true">
		<picture>
			<source srcset="/scss/image/blog/banner/phone.webp?v=2" type="image/webp" />
			<img
				src="/scss/image/blog/banner/phone.png?v=2"
				alt=""
				width="938"
				height="1256"
				loading="lazy"
				decoding="async"
			/>
		</picture>
	</div>
	<div class="final-banner-body">
		<h3>{heading}</h3>
		<p>{text}</p>
		<ul class="final-banner-features">
			{features.map((f) => (
				<li><span class="final-banner-ic">{f.ic}</span> {f.label}</li>
			))}
		</ul>
		<a href={href} class="final-banner-btn">Try free for 3 days</a>
	</div>
</div>
