---
import AppleIcon from './AppleIcon.astro';

interface Props {
	heading: string;
	text: string;
	href: string;
	/** Button label. Defaults to the App Store wording. */
	label?: string;
	/** 'apple' for App Store links, 'download' for the free-template PDF. */
	icon?: 'apple' | 'download';
	/** Set for file downloads so the browser saves rather than navigates. */
	download?: boolean;
}
const { heading, text, href, label = 'Download on App Store', icon = 'apple', download = false } =
	Astro.props;
---

<div class="article-cta">
	<h3>{heading}</h3>
	<p>{text}</p>
	<a href={href} class="app-store-btn app-store-btn-sm" download={download ? true : undefined}>
		{
			icon === 'apple' ? (
				<AppleIcon />
			) : (
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
					<polyline points="7 10 12 15 17 10" />
					<line x1="12" y1="15" x2="12" y2="3" />
				</svg>
			)
		}
		{label}
	</a>
</div>
