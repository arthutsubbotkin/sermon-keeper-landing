---
interface Props {
	heading: string;
	text: string;
	href: string;
	/** Button label, used only by the plain download variant. */
	label?: string;
	/** 'apple' renders the illustrated app banner; 'download' the plain PDF card. */
	icon?: 'apple' | 'download';
	/** Set for file downloads so the browser saves rather than navigates. */
	download?: boolean;
}
const { heading, text, href, label = 'Download on App Store', icon = 'apple', download = false } =
	Astro.props;
const base = '/scss/image/blog/banner';
---

{
	icon === 'apple' ? (
		/* App promo: the illustrated banner from the mockup (Figma 128:1716 desktop,
		   131:1856 mobile). Heading and text stay per-article; the button is fixed. */
		<div class="banner-cta">
			<div class="banner-cta-media" aria-hidden="true">
				<picture class="banner-cta-illus banner-cta-illus-wide">
					<source srcset={`${base}/banner-desktop.webp`} type="image/webp" />
					<img
						src={`${base}/banner-desktop.png`}
						alt=""
						width="760"
						height="620"
						loading="lazy"
						decoding="async"
					/>
				</picture>
				<picture class="banner-cta-illus banner-cta-illus-tall">
					<source srcset={`${base}/banner-mobile.webp`} type="image/webp" />
					<img
						src={`${base}/banner-mobile.png`}
						alt=""
						width="760"
						height="442"
						loading="lazy"
						decoding="async"
					/>
				</picture>
			</div>
			<div class="banner-cta-body">
				{/* Fixed banner copy from the mockup, not the per-article CTA text. */}
				<h3>Catch every word this Sunday</h3>
				<p>From the opening prayer to the final point, Sermon Keeper records it, writes it down, and hands you the summary.</p>
				<a href={href} class="banner-cta-btn">
					Try free for 3 days
				</a>
			</div>
		</div>
	) : (
		<div class="article-cta">
			<h3>{heading}</h3>
			<p>{text}</p>
			<a
				href={href}
				class="app-store-btn app-store-btn-sm"
				download={download ? true : undefined}
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
					<polyline points="7 10 12 15 17 10" />
					<line x1="12" y1="15" x2="12" y2="3" />
				</svg>
				{label}
			</a>
		</div>
	)
}
