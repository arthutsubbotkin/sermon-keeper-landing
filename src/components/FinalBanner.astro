---
import AppleIcon from './AppleIcon.astro';
import { pageAppStoreUrl } from '../utils/site';

interface Props {
	/** App Store campaign token for this placement, e.g. landing_home_final. */
	ct: string;
	/** On the blog the banner lines up with the article grid (1140px, 2rem sides) instead of the homepage's. */
	blog?: boolean;
}
const { ct, blog = false } = Astro.props;
const IMG = '/scss/image/home';
---

<!-- the closing offer, after the app's own paywall: blue with soft rings, white feature rows with the
     paywall's icons, and its white price card floating over the photo the way sugar.no lays cards on photos.
     Shared by the homepage and the blog. -->
<section class:list={['h-final', { 'is-blog': blog }]}>
	<div class="h-final-card" data-reveal>
		<div class="h-final-copy">
			<h2>Nothing lost<br />while you listen</h2>
			<ul class="f-list">
				<li><i style={`--ic:url(${IMG}/pw/paywall_icon_sparkles.svg)`}></i>Summary, outline, verses and steps, plus every word</li>
				<li><i style={`--ic:url(${IMG}/pw/paywall_icon_quote.svg)`}></i>Verses appear as you type</li>
				<li><i style={`--ic:url(${IMG}/pw/clock-plus.svg)`}></i>Tap a note, hear that moment</li>
			</ul>
			<a href={pageAppStoreUrl(ct)} class="f-btn"><AppleIcon class="f-btn-ico" />Start free trial</a>
			<span class="h-final-small">No account needed · English and Spanish</span>
		</div>
		<div class="h-final-pic">
			<img src={`${IMG}/final-friends.webp`} alt="Two friends after church, one holding a Bible, the other showing her phone" width="693" height="642" loading="lazy" decoding="async" />
			<div class="f-price" aria-label="Free trial">
				<b>3 days free trial</b>
				<small>then $64.99/year · less than $5.42/mo</small>
			</div>
		</div>
	</div>
</section>

<style>
	.h-final { max-width: 1200px; margin: 0 auto; padding: calc(var(--section-y) / 2) var(--gutter) var(--section-y); }
	/* same edges as .blog-list above it, which already leaves the space on top */
	.h-final.is-blog { max-width: calc(1140px + 4rem); padding: 0 2rem var(--section-y); }
	/* the paywall's blue (#3E7AF5) with its three faint rings, centred behind the two friends */
	.h-final-card { position: relative; overflow: hidden; border-radius: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); align-items: end;
		background: radial-gradient(circle at 75% 62%, rgba(255,255,255,.14) 0 22%, rgba(255,255,255,.10) 22% 34%, rgba(255,255,255,.06) 34% 48%, transparent 48%), #3E7AF5; }
	.h-final-copy { padding: var(--card-pad); padding-right: 0; align-self: center; color: #fff; }
	.h-final h2 { color: #fff; font-weight: 600; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1.06; letter-spacing: -0.03em; margin: 0 0 var(--s-6); }
	.f-list { list-style: none; margin: 0 0 var(--s-6); padding: 0; display: flex; flex-direction: column; gap: var(--s-3); }
	.f-list li { display: flex; align-items: center; gap: var(--s-3); font-size: 1.05rem; line-height: 1.35; }
	/* the paywall's badge: a white 20% circle with the app's own line icon in white */
	.f-list i { flex: none; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.2); position: relative; }
	.f-list i::after { content: ''; position: absolute; inset: 9px; background: #fff; -webkit-mask: var(--ic) center / contain no-repeat; mask: var(--ic) center / contain no-repeat; }
	/* the homepage's white pill button */
	.f-btn { display: inline-flex; align-items: center; gap: .55em; background: #fff; color: #0B1220; font-weight: 600; font-size: 1.05rem;
		padding: var(--s-4) var(--s-6); border-radius: 999px; text-decoration: none; transition: transform .15s; }
	.f-btn:hover { transform: translateY(-1px); color: #0B1220; }
	.f-btn :global(.f-btn-ico) { width: 1.15em; height: 1.15em; fill: currentColor; }
	.h-final-small { display: block; margin-top: var(--s-3); color: rgba(255,255,255,.75); font-size: .875rem; }
	.h-final-pic { position: relative; align-self: end; }
	/* pinned to the right edge: the photo is cut off on the right, so it must touch the card there */
	.h-final-pic img { display: block; width: 100%; max-width: 560px; height: auto; margin: var(--s-6) 0 0 auto; }
	/* the paywall's white bottom card, tilted and floating like the hero cards */
	.f-price { position: absolute; right: 2%; bottom: 6%; background: #fff; border-radius: 24px; padding: var(--s-4) var(--s-5); color: #17171A;
		box-shadow: 0 18px 40px rgba(10,30,80,.25); transform: rotate(4deg); animation: f-float 7s ease-in-out infinite; }
	.f-price b { display: block; font-size: 1.5rem; letter-spacing: -0.02em; font-weight: 600; }
	.f-price small { display: block; margin-top: var(--s-1); color: #6B7280; font-size: .875rem; }
	@keyframes f-float { 50% { translate: 0 -8px; } }

	@media (max-width: 899px) {
		.h-final-card { grid-template-columns: 1fr; gap: 0; background: radial-gradient(circle at 50% 78%, rgba(255,255,255,.14) 0 26%, rgba(255,255,255,.10) 26% 40%, rgba(255,255,255,.06) 40% 56%, transparent 56%), #3E7AF5; }
		/* phones: tighter type and spacing, a smaller photo on the right, and the price card on the free blue
		   sky to its upper left so it covers no one's hands or the Bible */
		.h-final-copy { padding: 28px 24px 0; }
		.h-final h2 { font-size: 1.75rem; margin-bottom: var(--s-4); }
		.f-list { gap: var(--s-2); margin-bottom: var(--s-5); }
		.f-list li { font-size: .9375rem; }
		.f-list i { width: 32px; height: 32px; }
		.f-list i::after { inset: 7px; }
		.h-final-pic img { width: 70%; max-width: 340px; margin-top: var(--s-2); }
		.f-price { left: 5%; right: auto; top: 4%; bottom: auto; padding: var(--s-3) var(--s-4); border-radius: 18px; transform: rotate(-4deg); }
		.f-price b { font-size: 1rem; white-space: nowrap; }
		.f-price small { font-size: .75rem; line-height: 1.35; max-width: 11em; }
	}
	@media (prefers-reduced-motion: reduce) { .f-price { animation: none; } }
</style>
