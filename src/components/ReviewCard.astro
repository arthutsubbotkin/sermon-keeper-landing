---
interface Props {
	rank: number;
	name: string;
	id: string;
	tagline: string;
	score: string;
	pricing: string;
	platforms: string;
	bestForMeta: string;
	like: string[];
	know: string[];
	bestFor: string;
	skipIf: string;
	/** App Store URL. Rendered filled (primary) when `winner` or `primaryCta` is set. */
	appStore?: string;
	/** Secondary link (official site, or a "Built into iPhone" link for defaults). */
	site?: string;
	siteLabel?: string;
	hero?: string;
	heroAlt?: string;
	/** Intrinsic size of `hero`, so the layout reserves the right box. */
	heroWidth?: number;
	heroHeight?: number;
	/** Shown as "Last reviewed: …". Bump only on cards that were actually re-reviewed. */
	reviewed?: string;
	winner?: boolean;
	/** Fill the App Store button without awarding the "Winner" badge — used for our
	 *  own app in roundups (e.g. "best free") where it isn't the category winner. */
	primaryCta?: boolean;
}
const {
	rank, name, id, tagline, score, pricing, platforms, bestForMeta,
	like, know, bestFor, skipIf, appStore, site, siteLabel = 'Visit site',
	hero, heroAlt = '', heroWidth = 950, heroHeight = 720, reviewed = 'August 2026',
	winner = false, primaryCta = false,
} = Astro.props;
---

<h2 id={id}>{rank}. {name}{winner && <span class="winner-badge">&#9733; Winner</span>}</h2>

<div class="rev">
	<p class="rev-tag">{tagline}</p>
	{hero && (
		<div class="rev-hero">
			<img src={hero} alt={heroAlt} width={heroWidth} height={heroHeight} loading="lazy" decoding="async" />
		</div>
	)}
	<div class="rev-meta">
		<div><div class="lbl">Our score</div><div class="val">{score}<span class="u">/10</span></div></div>
		<div><div class="lbl">Pricing</div><div class="val">{pricing}</div></div>
		<div><div class="lbl">Platforms</div><div class="val">{platforms}</div></div>
		<div><div class="lbl">Best for</div><div class="val">{bestForMeta}</div></div>
	</div>
	<div class="rev-cols">
		<div class="rev-like">
			<h4>What we like</h4>
			<ul>{like.map((item) => <li>{item}</li>)}</ul>
		</div>
		<div class="rev-know">
			<h4>What to know</h4>
			<ul>{know.map((item) => <li>{item}</li>)}</ul>
		</div>
	</div>
	<div class="rev-boxes">
		<div class="rev-box box-for"><div class="bl">Best for</div>{bestFor}</div>
		<div class="rev-box box-skip"><div class="bl">Skip if</div>{skipIf}</div>
	</div>
	{/* Only OUR app (winner/primaryCta) gets an App Store button — we don't hand
	    installs to other apps' store pages. Competitors get their site link only,
	    opened in a new tab so the reader's session stays on ours. */}
	<div class="rev-act">
		{appStore && (winner || primaryCta) && (
			<a class:list={['rev-btn', { primary: true }]} href={appStore}>App Store &rarr;</a>
		)}
		{site && (
			<a
				class="rev-btn"
				href={site}
				target={winner || primaryCta ? undefined : '_blank'}
				rel={winner || primaryCta ? undefined : 'noopener'}
			>{siteLabel} &rarr;</a>
		)}
		<span class="rev-when">Last reviewed: {reviewed}</span>
	</div>
</div>
